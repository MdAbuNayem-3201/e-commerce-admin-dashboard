
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


// ENUMS

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum AttributeType {
  DROPDOWN
  RADIO
  CHECKBOX
  COLOR_SWATCH
  IMAGE_SWATCH
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
  LOW_STOCK
}

//PERMISSION and ROLE

model PermissionGroup {
  id          String       @id @default(cuid())
  name        String       @unique // module name e.g. "Product"
  description String?
  permissions Permission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permission_groups")
}

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique // e.g. module name => "product:create"
  description String?

  groupId String
  group   PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@map("permissions")
}

model Role {
  id          String     @id @default(cuid())
  name        String     @unique
  description String?
  status      RoleStatus @default(ACTIVE)

  permissions RolePermission[]
  users       User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

// MODULE 4: USER

model User {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  password     String
  phone        String?
  gender       Gender?
  avatar       String?
  refreshToken String? // current valid refresh token (rotated on each refresh)
  isActive     Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  uploadedMedia Media[]

  deletedAt DateTime? // soft-delete marker
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([roleId])
  @@map("users")
}

// MODULE 5: MEDIA

model Media {
  id           String    @id @default(cuid())
  fileName     String
  storedPath   String // cloudinary public_id
  publicUrl    String
  mimeType     String
  type         MediaType
  size         Int
  width        Int?
  height       Int?
  thumbnailUrl String?
  altText      String?
  title        String?

  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  categoryImageFor Category[]        @relation("CategoryImage")
  brandLogoFor     Brand[]           @relation("BrandLogo")
  attachments      MediaAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([uploadedById])
  @@map("media")
}

// ==========================================================
// MODULE 6: CATEGORY
// ==========================================================

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  imageId String?
  image   Media?  @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// ==========================================================
// MODULE 7: BRAND
// ==========================================================

model Brand {
  id          String      @id @default(cuid())
  name        String      @unique
  slug        String      @unique
  status      BrandStatus @default(ACTIVE)
  description String?

  logoId String?
  logo   Media?  @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@map("brands")
}

// MODULE 8: ATTRIBUTE

model Attribute {
  id   String        @id @default(cuid())
  name String        @unique
  slug String        @unique
  type AttributeType

  values AttributeValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("attributes")
}

model AttributeValue {
  id             String  @id @default(cuid())
  value          String
  slug           String
  referenceValue String? // hex code for color, or a media id for image swatch

  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  variantLinks     VariantAttributeValue[]
  mediaAttachments MediaAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([attributeId, slug])
  @@index([attributeId])
  @@map("attribute_values")
}

// ==========================================================
// MODULE 9: PRODUCT
// ==========================================================

model Product {
  id               String  @id @default(cuid())
  name             String
  slug             String  @unique
  sku              String? @unique // meaningful only when hasVariants = false
  shortDescription String?
  longDescription  String?

  hasVariants Boolean @default(false)

  // used only when hasVariants = false
  price       Decimal?     @db.Decimal(12, 2)
  salePrice   Decimal?     @db.Decimal(12, 2)
  stock       Int?
  stockStatus StockStatus?

  weight     Decimal? @db.Decimal(10, 3)
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)
  sortOrder  Int      @default(0)

  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  categories ProductCategory[]
  media      MediaAttachment[]
  variants   ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([brandId])
  @@map("products")
}

model ProductCategory {
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductVariant {
  id  String @id @default(cuid())
  sku String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  price             Decimal     @db.Decimal(12, 2)
  salePrice         Decimal?    @db.Decimal(12, 2)
  stock             Int
  stockStatus       StockStatus @default(IN_STOCK)
  lowStockThreshold Int?

  weight   Decimal? @db.Decimal(10, 3)
  isActive Boolean  @default(true)

  attributeValues VariantAttributeValue[]
  media           MediaAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model VariantAttributeValue {
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId String
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
  @@map("variant_attribute_values")
}

// Polymorphic-ish media attachment: attached to a product, OR a variant, OR an attribute value.
// Exactly one of productId / variantId / attributeValueId should be non-null; enforced in the service layer.
model MediaAttachment {
  id String @id @default(cuid())

  mediaId String
  media   Media  @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  attributeValueId String?
  attributeValue   AttributeValue? @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  isThumbnail Boolean @default(false)
  isGallery   Boolean @default(true)
  sortOrder   Int     @default(0)

  createdAt DateTime @default(now())

  @@index([mediaId])
  @@index([productId])
  @@index([variantId])
  @@index([attributeValueId])
  @@map("media_attachments")
}
