{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,

    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "skipLibCheck": true,

    "resolveJsonModule": true,

    "allowSyntheticDefaultImports": true,

    "outDir": "./dist",

    "rootDir": "./src",

    "types": ["node"],
    
    // ✅ Add this to include custom type declarations
    "typeRoots": ["./node_modules/@types", "./src/types"]
  },

  "include": ["src/**/*"],
  
  "exclude": [
    "node_modules",
    "dist"
  ]
}